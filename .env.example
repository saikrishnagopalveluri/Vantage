# Copy to .env and fill in. Never commit .env.

# ---- Where the site lives -------------------------------------------------------------------
# A real domain name that points at this server (Caddy then gets the HTTPS certificate itself),
# or http://localhost to try it out on your own machine without HTTPS.
DOMAIN=localhost
# Change these only if ports 80 and 443 are already taken.
HTTP_PORT=80
HTTPS_PORT=443

# ---- Security -------------------------------------------------------------------------------
# Signs session cookies. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# If you leave it empty a key file is created inside the data volume, which also works.
VANTAGE_SECRET=

# Set to 1 to always mark the login cookie Secure (only when the site is served over HTTPS).
VANTAGE_COOKIE_SECURE=0

# 0 means everyone needs an account. 1 lets people try the app as a guest.
VANTAGE_ALLOW_GUESTS=1

# ---- Who runs this copy (shown on the Terms and Privacy pages) ------------------------------
# Until these are filled in the legal pages say "Not set yet". Have a lawyer review those pages.
VANTAGE_OPERATOR_NAME=
VANTAGE_CONTACT_EMAIL=
VANTAGE_GRIEVANCE_OFFICER=
VANTAGE_GRIEVANCE_EMAIL=
VANTAGE_POSTAL_ADDRESS=
VANTAGE_HOSTING_REGION=

# ---- Feeds ----------------------------------------------------------------------------------
# How often the API pulls news, in minutes, and the hour (UTC) of the daily clean-up.
VANTAGE_INGEST_EVERY_MINUTES=60
VANTAGE_DAILY_HOUR_UTC=3

# ---- Database ---------------------------------------------------------------------------------
# Leave empty to use the SQLite file in the data volume. To use Supabase (or any Postgres) instead,
# paste its connection string here; postgres:// and postgresql:// both work.
DATABASE_URL=

# ---- Push notifications -----------------------------------------------------------------------
# Web Push (VAPID) keys. Generate a pair with: python -m app.vapid_gen
# Leave both empty to turn push notifications off entirely — subscribing just fails quietly.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Shown to push services as the contact for this server, per the Web Push spec. A real mailto: address.
VAPID_SUBJECT=mailto:hello@example.com

# ---- Adding a missing role or company ------------------------------------------------------
# Google Custom Search: console.cloud.google.com (enable "Custom Search API", then Credentials)
# for the key, and programmablesearchengine.google.com for the engine ID. Scope the engine to a
# handful of reference sites (Wikipedia, LinkedIn, O*NET...) in its own console — this app only
# ever sends it a query, never a site list. Leave both empty to turn this off entirely: the "add
# it yourself" path still works, it just comes with no web context.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
